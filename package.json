    "ffmpeg-static": "^5.3.0",
    "logger": "file:lib/logger",
    "mysql2": "^3.16.0",
    "youtube-dl-exec": "^3.0.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
